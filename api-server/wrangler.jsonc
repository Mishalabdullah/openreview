{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 1337 },
  // Local simulation only until these queues are explicitly provisioned/deployed.
  "queues": {
    "producers": [
      { "binding": "REVIEW_QUEUE", "queue": "openreview-reviews-local" },
    ],
    "consumers": [
      {
        "queue": "openreview-reviews-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "openreview-reviews-local-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "vars": {
    "ENVIRONMENT": "local",
    "BETTER_AUTH_URL": "http://localhost:1337",
    "FRONTEND_URL": "http://localhost:5173",
  },
  "env": {
    "dev": {
      "name": "openreview-api-dev",
      "workers_dev": false,
      "routes": [{ "pattern": "api.dev.openreview.si", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "dev",
        "BETTER_AUTH_URL": "https://api.dev.openreview.si",
        "FRONTEND_URL": "https://dev.openreview.si",
      },
      // Required before deployment (disable Hyperdrive query caching for auth):
      // ,"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<DEV_HYPERDRIVE_ID>" }]
    },
    "production": {
      "name": "openreview-api-production",
      "workers_dev": false,
      "routes": [{ "pattern": "api.openreview.si", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://api.openreview.si",
        "FRONTEND_URL": "https://openreview.si",
      },
      // ,"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<PRODUCTION_HYPERDRIVE_ID>" }]
    },
  },
}
