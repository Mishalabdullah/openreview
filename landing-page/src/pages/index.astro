---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReviewPreview from '../components/ReviewPreview.astro';
import DeveloperControl from '../components/DeveloperControl.astro';
import { GET_STARTED_URL, GITHUB_URL } from '../consts';
const features: {
	icon: string;
	title: string;
	description: string;
}[] = [
	{
		icon: '−  +',
		title: 'Clarity in every diff.',
		description:
			'Scan changes without the clutter. Keep the code and its context right where you need them.',
	},
	{
		icon: '[ … ]',
		title: 'Conversations that move.',
		description:
			'Turn feedback into progress with focused threads and clear resolutions. Less back-and-forth. More building.',
	},
	{
		icon: '</>',
		title: 'Open by design.',
		description:
			'Read the source. Shape the roadmap. Make your review workflow your own. Good tools belong to their community.',
	},
];
const steps = [
	{ title: 'Open the app', description: 'Start online. No self-hosting required.' },
	{ title: 'Make reviews yours', description: 'Bring your provider and define your review rules.' },
	{
		title: 'Merge with confidence',
		description: 'Resolve, approve, and ship.',
	},
];
---

<SiteLayout>
	<div class="container">
		<section class="hero" aria-labelledby="hero-title">
			<a href={GET_STARTED_URL} class="release-pill mono">
				<span class="status-dot" aria-hidden="true"></span>OpenReview is live / Open the app <span aria-hidden="true">↗</span>
			</a>
			<h1 id="hero-title">
				Less back-and-forth.
				<br />
				More forward.
			</h1>
			<p class="hero-description">
				Your open-source AI code review agent. Start reviewing online,
				<br />
				bring your own API keys, and make every review follow your rules.
			</p>
			<div class="hero-actions">
				<a href={GET_STARTED_URL} class="button">
					Start reviewing now <span aria-hidden="true">→</span>
				</a>
				<a href={GITHUB_URL} class="button button-secondary">
					View source on GitHub <span aria-hidden="true">↗</span>
				</a>
			</div>
			<p class="hero-note mono">
				Use the hosted app. Or self-host. Your workflow, your choice.
			</p>
		</section>
		<ReviewPreview />
		<section class="features" id="product" aria-labelledby="features-title">
			<p class="eyebrow">01 / The review, reconsidered</p>
			<h2 id="features-title" class="section-title">
				Everything you need. Nothing in your way.
			</h2>
			<div class="feature-grid">
				{features.map((feature, index) => (
					<article class="feature">
						<div class="feature-top">
							<span>0{index + 1}</span>
							<span class="feature-icon" aria-hidden="true">
								{feature.icon}
							</span>
						</div>
						<h3>{feature.title}</h3>
						<p>{feature.description}</p>
					</article>
				))}
			</div>
		</section>
		<aside class="open-source-statement" aria-label="Why OpenReview is open source">
			<p class="eyebrow">The next tool should be open, too.</p>
			<p class="statement-copy">
				Open-source editors changed how we write code.
				<strong>Why not an open-source agent to review it?</strong>
			</p>
		</aside>
		<DeveloperControl />
		<section class="workflow" aria-labelledby="workflow-title">
			<h2 id="workflow-title" class="eyebrow">
				03 / From first diff to final approval
			</h2>
			<div class="workflow-grid">
				{steps.map((step, index) => (
					<div>
						<span class="mono muted">0{index + 1} &nbsp; →</span>
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				))}
			</div>
		</section>
		<div class="open-ribbon mono">
			<span class="accent">⌘ &nbsp; Developer owned</span>
			<span>No black boxes</span>
			<a href="/about/">A better review starts with you ↗</a>
		</div>
		<section class="closing">
			<h2>Your next great merge starts here.</h2>
			<p>Open the app and put AI code review to work. Your keys. Your rules.</p>
			<div class="closing-actions">
				<a class="button" href={GET_STARTED_URL}>
					Open OpenReview <span aria-hidden="true">→</span>
				</a>
				<span class="mono">
					Live now at app.openreview.si. Self-hosting optional.
				</span>
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.open-source-statement {
		margin-top: 85px;
		padding: 42px 24px;
		border-block: 1px solid var(--line);
		text-align: center;
	}
	.open-source-statement .eyebrow {
		font-size: 9px;
		letter-spacing: 0.08em;
	}
	.statement-copy {
		margin: 22px auto 0;
		max-width: 1050px;
		font-size: clamp(23px, 2.6vw, 35px);
		line-height: 1.45;
		letter-spacing: -0.035em;
		color: var(--muted);
		text-wrap: balance;
	}
	.statement-copy strong {
		display: block;
		margin-top: 5px;
		color: var(--text);
		font-weight: 650;
	}
	@media (max-width: 760px) {
		.open-source-statement {
			margin-top: 55px;
			padding: 32px 0;
		}
		.statement-copy strong {
			margin-top: 14px;
		}
	}
</style>
