---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import StoryCover from '../../components/StoryCover.astro';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const categories = [
	'All stories',
	'Engineering',
	'Code review',
	'Open source',
	'Changelog',
];
const readTime = (body?: string) =>
	`${Math.max(1, Math.ceil((body ?? '').split(/\s+/).length / 200))} min read`;
---

<SiteLayout
	title="Code Review &amp; Open-Source Engineering — OpenReview Journal"
	description="Explore code review practices, pull request workflows, and open-source engineering from the team building OpenReview, an AI code review agent."
>
	<div class="container">
		<section class="journal-hero">
			<p class="eyebrow">The OpenReview journal</p>
			<h1>
				Notes from
				<br />
				the other side of the diff.
			</h1>
			<div class="journal-intro">
				<p>
					Ideas, engineering notes, and a few strong opinions
					<br />
					on building better software together.
				</p>
				<span class="mono">FOR PEOPLE WHO READ THE CODE.</span>
			</div>
		</section>
		<div class="filters" role="group" aria-label="Filter stories by category">
			{categories.map((category, i) => (
				<button
					class="filter-button"
					type="button"
					data-filter={category}
					aria-pressed={i === 0}
				>
					{category}
				</button>
			))}
		</div>
		<div class="featured-section" data-story-category={featured.data.category}>
			<p class="eyebrow muted">01 / The latest thinking</p>
			<article class="featured-story">
				<a
					href={`/blog/${featured.id}/`}
					aria-label={`Read ${featured.data.title}`}
				>
					<StoryCover variant={featured.data.cover} />
				</a>
				<div>
					<p class="eyebrow">
						{featured.data.category} / {readTime(featured.body)}
					</p>
					<a href={`/blog/${featured.id}/`}>
						<h2>{featured.data.title}</h2>
					</a>
					<p>{featured.data.description}</p>
					<a class="text-link" href={`/blog/${featured.id}/`}>
						Read the story <span aria-hidden="true">↗</span>
					</a>
				</div>
			</article>
		</div>
		<section class="more-stories" aria-labelledby="more-title">
			<h2 class="eyebrow muted" id="more-title">
				02 / More from the journal
			</h2>
			<div class="story-grid">
				{posts
					.filter((post) => post.id !== featured.id)
					.map((post) => (
						<article
							class="story-card"
							data-story-category={post.data.category}
						>
							<a href={`/blog/${post.id}/`}>
								<StoryCover variant={post.data.cover} />
								<p class="eyebrow">
									{post.data.category} / {readTime(post.body)}
								</p>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<span class="text-link">
									Read story <span aria-hidden="true">↗</span>
								</span>
							</a>
						</article>
					))}
			</div>
			<p class="empty-filter" hidden>
				No stories in this category yet. Good things take a little time.
			</p>
			<p class="sr-only" role="status" data-filter-status></p>
		</section>
		<aside class="newsletter">
			<div>
				<p class="eyebrow">A signal worth subscribing to.</p>
				<h2>Good reads. No noise.</h2>
				<p>
					Engineering notes and product updates. Only when we have something to
					say.
				</p>
			</div>
			<div class="newsletter-actions">
				<a class="button" href="/rss.xml">
					Subscribe via RSS <span aria-hidden="true">↗</span>
				</a>
				<span class="mono">YOUR READER. YOUR INBOX. NO ALGORITHM.</span>
			</div>
		</aside>
	</div>
</SiteLayout>
<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const stories = document.querySelectorAll<HTMLElement>(
		'[data-story-category]',
	);
	function filterStories(category: string) {
		let count = 0;
		stories.forEach((story) => {
			story.hidden =
				category !== 'All stories' && story.dataset.storyCategory !== category;
			if (!story.hidden) count++;
		});
		buttons.forEach((button) =>
			button.setAttribute(
				'aria-pressed',
				String(button.dataset.filter === category),
			),
		);
		const empty = document.querySelector<HTMLElement>('.empty-filter');
		if (empty) empty.hidden = count > 0;
		const status = document.querySelector('[data-filter-status]');
		if (status)
			status.textContent = `${count} ${count === 1 ? 'story' : 'stories'} shown`;
	}
	const initial = new URL(location.href).searchParams.get('category');
	if (
		initial &&
		[...buttons].some((button) => button.dataset.filter === initial)
	)
		filterStories(initial);
	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			const category = button.dataset.filter!;
			filterStories(category);
			const url = new URL(location.href);
			if (category === 'All stories') url.searchParams.delete('category');
			else url.searchParams.set('category', category);
			history.replaceState(null, '', url);
		}),
	);
</script>
