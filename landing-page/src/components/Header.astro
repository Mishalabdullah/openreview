---
import Logo from './Logo.astro';
import { DOCS_URL, GET_STARTED_URL } from '../consts';
const journal = Astro.url.pathname.startsWith('/blog');
---

<header class="site-header container">
	<a href="/" aria-label="OpenReview home">
		<Logo />
	</a>
	<nav class="desktop-nav" aria-label="Main navigation">
		<a href="/#product">Product</a>
		<a
			href="/about/"
			aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}
		>
			Manifesto
		</a>
		<a href={DOCS_URL}>
			Docs <span class="external-arrow">↗</span>
		</a>
		<a href="/blog/" aria-current={journal ? 'page' : undefined}>
			Journal
		</a>
	</nav>
	<div class="header-actions">
		<button
			class="theme-toggle"
			type="button"
			aria-label="Switch to light theme"
			title="Switch theme"
		>
			<svg
				class="sun-icon"
				width="17"
				height="17"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
			</svg>
			<svg
				class="moon-icon"
				width="17"
				height="17"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
			</svg>
			<span class="theme-label mono">Dark</span>
		</button>
		<a class="button button-small header-cta" href={GET_STARTED_URL}>
			Open app <span aria-hidden="true">↗</span>
		</a>
		<button
			class="menu-toggle"
			aria-label="Open navigation"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<span></span>
			<span></span>
		</button>
	</div>
	<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
		<a href="/#product">Product</a>
		<a href="/about/">Manifesto</a>
		<a href={DOCS_URL}>Documentation ↗</a>
		<a href="/blog/">Journal</a>
		<a href={GET_STARTED_URL}>Open app ↗</a>
	</nav>
</header>
<script>
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const syncTheme = () => {
		const dark = root.dataset.theme !== 'light';
		toggle?.setAttribute(
			'aria-label',
			`Switch to ${dark ? 'light' : 'dark'} theme`,
		);
		const label = toggle?.querySelector('.theme-label');
		if (label) label.textContent = dark ? 'Dark' : 'Light';
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', dark ? '#0B1020' : '#F8F9FC');
	};
	syncTheme();
	toggle?.addEventListener('click', () => {
		const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = theme;
		try {
			localStorage.setItem('openreview-theme', theme);
		} catch {}
		syncTheme();
	});
	window
		.matchMedia('(prefers-color-scheme: light)')
		.addEventListener('change', (event) => {
			try {
				if (localStorage.getItem('openreview-theme')) return;
			} catch {}
			root.dataset.theme = event.matches ? 'light' : 'dark';
			syncTheme();
		});
	const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.querySelector<HTMLElement>('#mobile-nav');
	const closeMenu = () => {
		if (nav) nav.hidden = true;
		menu?.setAttribute('aria-expanded', 'false');
	};
	menu?.addEventListener('click', () => {
		if (!nav) return;
		nav.hidden = !nav.hidden;
		menu.setAttribute('aria-expanded', String(!nav.hidden));
	});
	nav
		?.querySelectorAll('a')
		.forEach((link) => link.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
			menu?.focus();
		}
	});
</script>
