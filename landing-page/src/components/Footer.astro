---
import Logo from './Logo.astro';
import { DOCS_URL, GITHUB_URL } from '../consts';
---

<footer class="site-footer container">
	<div>
		<a href="/" aria-label="OpenReview home">
			<Logo />
		</a>
		<p class="mono">Built in the open. For the people who build.</p>
	</div>
	<nav aria-label="Footer navigation">
		<a href={GITHUB_URL}>GitHub ↗</a>
		<a href={DOCS_URL}>Docs</a>
		<a href="/blog/">Journal</a>
		<a href="/brand/">Identity</a>
		<a href={`${GITHUB_URL}/discussions`}>Community</a>
	</nav>
	<svg
		class="footer-display-wordmark"
		viewBox="0 0 1200 250"
		aria-hidden="true"
		focusable="false"
		xmlns="http://www.w3.org/2000/svg"
	>
		<text x="5" y="180" textLength="1190" lengthAdjust="spacingAndGlyphs">
			openreview
		</text>
	</svg>
	<span class="footer-copyright mono">
		© {new Date().getFullYear()} OpenReview
	</span>
</footer>
