{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openreview-frontend-local",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "dev": {
      "name": "openreview-frontend-dev",
      "routes": [{ "pattern": "dev.openreview.si", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
    "production": {
      "name": "openreview-frontend-production",
      "routes": [{ "pattern": "openreview.si", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
